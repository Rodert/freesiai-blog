---
import {giscus} from '../config/integrations';const {id}=Astro.props;const enabled=!!(giscus.repo&&giscus.repoId&&giscus.category&&giscus.categoryId);
---
<section data-pagefind-ignore class="comments"><h2>评论</h2>{enabled?<script is:inline src="https://giscus.app/client.js" data-repo={giscus.repo} data-repo-id={giscus.repoId} data-category={giscus.category} data-category-id={giscus.categoryId} data-mapping="specific" data-term={`freesiai-post-${id}`} data-strict="1" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top" data-theme={giscus.theme} data-lang={giscus.lang} crossorigin="anonymous" async></script>:<p>评论尚未启用。</p>}</section>
