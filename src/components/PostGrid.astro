---
import {postUrl,dateLabel,type Post} from '../lib/posts';
import {categories} from '../config/categories';
const {posts=[] as Post[],empty='暂时还没有发布文章。'}=Astro.props;
---
{posts.length?<div class="post-grid">{posts.map((post:Post)=><article class="post-card"><a href={postUrl(post)} class="cover-link" tabindex="-1" aria-hidden="true">{post.data.cover?<img src={post.data.cover} alt="" width="640" height="360" loading="lazy"/>:<div class="cover-placeholder"><span>自由域</span><small>{categories[post.data.category]}</small></div>}</a><div class="card-body"><h2><a href={postUrl(post)}>{post.data.title}</a></h2><div class="card-meta"><time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time><a href={`/categories/${post.data.category}/`}>{categories[post.data.category]}</a></div></div></article>)}</div>:<div class="empty-state"><div class="empty-mark" aria-hidden="true"><svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="8" y="6" width="32" height="36" rx="3"/><path d="M16 16h16M16 24h16M16 32h9"/></svg></div><h2>内容正在准备中</h2><p>{empty}</p><a class="text-link" href="/about/">了解自由域 →</a></div>}
