---
import '../styles/global.css';
import {site,navigation} from '../config/site';
const {title=site.name,description=site.description,noindex=false,image='/share.svg'}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title===site.name?title:`${title} · ${site.name}`}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL(image,site.url).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="自由域 RSS" href="/rss.xml"/></head><body><a class="skip" href="#main">跳到正文</a><header class="header"><div class="header-inner"><a class="brand" href="/">自由域<span>AI 工具与实用教程</span></a><details class="mobile-menu"><summary>菜单</summary><nav aria-label="移动导航">{navigation.map(([label,url])=><a href={url}>{label}</a>)}<a href="/search/">搜索</a></nav></details><nav class="desktop-nav" aria-label="主导航">{navigation.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}<a class="search-link" href="/search/" aria-label="搜索文章"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg></a></nav></div></header><main id="main" class="container"><slot/></main><footer class="footer"><div><a href="/">自由域</a><span>AI 工具与实用教程</span></div><div><a href="/about/">关于</a><a href="/rss.xml">RSS</a><a href="/search/">搜索</a></div></footer></body></html>
