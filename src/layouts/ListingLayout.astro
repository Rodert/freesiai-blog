---
import Base from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
const {title,description}=Astro.props;
---
<Base title={title} description={description}><div class="listing-layout"><section class="listing"><div class="section-heading"><h1>{title}</h1>{description&&<p>{description}</p>}</div><slot/></section><Sidebar/></div></Base>
