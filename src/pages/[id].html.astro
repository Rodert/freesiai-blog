---
import {render} from 'astro:content';import Base from '../layouts/BaseLayout.astro';import Sidebar from '../components/Sidebar.astro';import Video from '../components/YouTubeEmbed.astro';import Comments from '../components/GiscusComments.astro';import {published,numericId,postUrl,dateLabel} from '../lib/posts';import {categories} from '../config/categories';import {site} from '../config/site';
export async function getStaticPaths(){const posts=await published();return posts.map((post,i)=>({params:{id:String(numericId(post))},props:{post,newer:posts[i-1],older:posts[i+1]}}));}
const {post,newer,older}=Astro.props;const {Content}=await render(post);const d=post.data;const schema={'@context':'https://schema.org','@type':'BlogPosting',headline:d.title,description:d.description,datePublished:d.pubDate.toISOString(),...(d.updatedDate?{dateModified:d.updatedDate.toISOString()}:{}),url:new URL(postUrl(post),site.url).href,...(d.cover?{image:new URL(d.cover,site.url).href}:{})};
---
<Base title={d.title} description={d.description} image={d.cover}><div class="listing-layout"><article class="article-panel" data-pagefind-body><nav data-pagefind-ignore class="breadcrumb" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href={`/categories/${d.category}/`}>{categories[d.category]}</a></nav><header class="article-header"><h1 data-pagefind-meta="title">{d.title}</h1><div class="article-meta" data-pagefind-ignore><time datetime={d.pubDate.toISOString()}>{dateLabel(d.pubDate)}</time>{d.updatedDate&&<span>更新于 {dateLabel(d.updatedDate)}</span>}<a href={`/categories/${d.category}/`}>{categories[d.category]}</a></div></header>{d.cover&&<img class="article-cover" src={d.cover} alt={d.title} width="1280" height="720"/>}<div class="prose"><Content/></div>{d.youtubeId&&<Video id={d.youtubeId} title={d.title}/>}<nav data-pagefind-ignore class="post-navigation" aria-label="相邻文章">{newer&&<a href={postUrl(newer)}><small>较新的文章</small>{newer.data.title}</a>}{older&&<a href={postUrl(older)}><small>较早的文章</small>{older.data.title}</a>}</nav><Comments id={numericId(post)}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/></article><Sidebar/></div></Base>
